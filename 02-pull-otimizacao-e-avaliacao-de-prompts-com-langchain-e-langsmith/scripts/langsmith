#!/usr/bin/env bash
# Prefer official LangSmith CLI (Go). Fall back to package docker CLI.
set -euo pipefail
OFFICIAL="${HOME}/.local/bin/langsmith"
if [[ -x "$OFFICIAL" ]]; then
  exec "$OFFICIAL" "$@"
fi
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -x "$SCRIPT_DIR/langsmith-docker" ]]; then
  exec "$SCRIPT_DIR/langsmith-docker" "$@"
fi
echo "langsmith CLI not found. Install: curl -fsSL https://cli.langsmith.com/install.sh | sh" >&2
exit 127

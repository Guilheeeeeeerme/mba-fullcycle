# Use "openai", "gemini" or "opencode-go".
# opencode-go = assinatura OpenCode Go (não Zen free / pay-as-you-go).
LLM_PROVIDER=openai
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENCODE_API_KEY=

# Optional model overrides (defaults shown).
# OPENAI_MODEL=gpt-5.6-luna
# GEMINI_MODEL=gemini-3.1-flash-lite
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# OPENCODE_GO_MODEL=glm-5.1
# Alternatives for OpenCode Go: kimi-k2.6, kimi-k3, glm-5.2, deepseek-v4-flash (China opt-in).

# Optional embedding override: openai | gemini | fastembed
# (opencode-go defaults to fastembed — Go has no embedding models)
# Changing LLM_PROVIDER or EMBEDDING_PROVIDER changes vector dimensions —
# re-run: python src/ingest.py
# EMBEDDING_PROVIDER=fastembed

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/semantic_search
PGVECTOR_COLLECTION=pdf_documents
PDF_PATH=document.pdf

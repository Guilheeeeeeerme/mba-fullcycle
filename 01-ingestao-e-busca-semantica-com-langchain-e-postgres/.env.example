# Use "openai", "gemini" or "opencode-go".
# opencode-go = assinatura OpenCode Go (não Zen free / pay-as-you-go).
LLM_PROVIDER=openai
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENCODE_API_KEY=
# Optional when LLM_PROVIDER=opencode-go (default: glm-5.1).
# Alternatives: kimi-k2.6, kimi-k3, glm-5.2, deepseek-v4-flash (China opt-in).
# OPENCODE_GO_MODEL=glm-5.1
# Optional embedding override: openai | gemini | fastembed
# (opencode-go defaults to fastembed — Go has no embedding models)
# EMBEDDING_PROVIDER=fastembed

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/semantic_search
PGVECTOR_COLLECTION=pdf_documents
PDF_PATH=document.pdf
